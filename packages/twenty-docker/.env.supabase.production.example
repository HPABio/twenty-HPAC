TAG=latest

# Public Twenty URL served by your VPS reverse proxy.
SERVER_URL=https://crm.example.com
PUBLIC_DOMAIN_URL=https://crm.example.com

# Use `openssl rand -base64 32`.
APP_SECRET=replace_me_with_a_random_string

# Same-server Supabase Postgres.
# Use a direct or session-pooler connection, never the transaction pooler.
# Use the same value in the Supabase compose env if you add
# `packages/twenty-docker/supabase/docker-compose.network.yml` to Supabase.
# For an already-running Supabase stack, find this with `docker network ls`.
# Supabase self-hosted networks often look like `supabase_network_<project-name>`.
# `db` works when Twenty is attached to the Supabase Docker network.
SUPABASE_DOCKER_NETWORK=supabase_network_your-project-name
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=replace_me
PG_DATABASE_HOST=db
# Match the port your Supabase `db` service listens on inside the Docker network
# (often 5432; self-hosted stacks that use internal sidecars may use 54322).
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=postgres
PG_SSL_ALLOW_SELF_SIGNED=false

# Process listen port inside the Twenty container (healthcheck + NODE_PORT)
NODE_PORT=3000
TWENTY_HOST_PORT=3000

# Twenty keeps its own Redis service in the Twenty compose project.
REDIS_URL=redis://redis:6379
DISABLE_DB_MIGRATIONS=
DISABLE_CRON_JOBS_REGISTRATION=

# Keep local storage only if the server-local-data Docker volume is backed up.
STORAGE_TYPE=local
STORAGE_S3_REGION=
STORAGE_S3_NAME=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PRESIGNED_URL_ENABLED=false
STORAGE_S3_PRESIGNED_URL_BASE=

# Switch to `smtp` once outbound mail is configured.
EMAIL_DRIVER=logger
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Twenty
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# Default trusts Docker/private reverse-proxy hops.
TRUST_PROXY=loopback, linklocal, uniquelocal
