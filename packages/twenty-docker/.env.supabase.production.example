TAG=latest

# Public Twenty URL served by your VPS reverse proxy.
SERVER_URL=https://crm.example.com
PUBLIC_DOMAIN_URL=https://crm.example.com

# Use `openssl rand -base64 32`.
APP_SECRET=replace_me_with_a_random_string

# Same-server Supabase Postgres.
# Use a direct or session-pooler connection, never the transaction pooler.
# Find this with `docker network ls`. Supabase self-hosted networks often look
# like `supabase_network_<project-name>`.
# `db` works when Twenty is attached to the Supabase Docker network.
SUPABASE_DOCKER_NETWORK=supabase_network_your-project-name
PG_DATABASE_URL=postgresql://postgres:replace_me@db:5432/postgres
PG_SSL_ALLOW_SELF_SIGNED=false

# Twenty keeps its own Redis service in the Twenty compose project.
REDIS_URL=redis://redis:6379
DISABLE_DB_MIGRATIONS=
DISABLE_CRON_JOBS_REGISTRATION=

# Keep local storage only if the server-local-data Docker volume is backed up.
STORAGE_TYPE=local
STORAGE_S3_REGION=
STORAGE_S3_NAME=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PRESIGNED_URL_ENABLED=false
STORAGE_S3_PRESIGNED_URL_BASE=

# Switch to `smtp` once outbound mail is configured.
EMAIL_DRIVER=logger
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Twenty
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# Default trusts Docker/private reverse-proxy hops.
TRUST_PROXY=loopback, linklocal, uniquelocal
