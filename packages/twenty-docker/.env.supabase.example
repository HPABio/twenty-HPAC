TAG=latest

############
# Self-hosted Supabase stack
############
CONTAINER_PREFIX=supabase
SUPABASE_HOST=supabase.example.com
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me
# URL-encoded copy of POSTGRES_PASSWORD for connection strings.
# Keep POSTGRES_PASSWORD raw for Postgres initialization.
POSTGRES_PASSWORD_URL_ENCODED=replace_me
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
PGRST_DB_SCHEMAS=public,storage,graphql_public
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
LOGFLARE_API_KEY=replace_me_with_a_32_character_secret
FUNCTIONS_VERIFY_JWT=false
IMGPROXY_ENABLE_WEBP_DETECTION=true
JWT_SECRET=replace_me_with_a_jwt_secret
ANON_KEY=replace_me_with_a_generated_anon_key
SERVICE_ROLE_KEY=replace_me_with_a_generated_service_role_key
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=replace_me
SECRET_KEY_BASE=replace_me_with_at_least_64_characters
VAULT_ENC_KEY=replace_me_with_32_characters
POOLER_TENANT_ID=replace_me
POOLER_MAX_CLIENT_CONN=100
POOLER_DEFAULT_POOL_SIZE=20
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
API_EXTERNAL_URL=https://supabase.example.com
STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
SUPABASE_PUBLIC_URL=https://supabase.example.com

# Use a direct or session-pooler PostgreSQL connection for Twenty.
# Do not use the Supabase transaction pooler for migrations or workspace DDL.
PG_DATABASE_URL=postgresql://twenty:replace_me@supabase.example.com:5432/twenty
PG_SSL_ALLOW_SELF_SIGNED=false

SERVER_URL=http://localhost:3000
REDIS_URL=redis://redis:6379
TWENTY_HOST_PORT=3000
DISABLE_DB_MIGRATIONS=
DISABLE_CRON_JOBS_REGISTRATION=

# Use openssl rand -base64 32 for each secret.
APP_SECRET=replace_me_with_a_random_string

# Supabase Storage can be used through Twenty's S3-compatible storage driver
# when your self-hosted Supabase deployment exposes the S3 protocol.
STORAGE_TYPE=local
STORAGE_S3_REGION=
STORAGE_S3_NAME=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PRESIGNED_URL_ENABLED=false
STORAGE_S3_PRESIGNED_URL_BASE=

# Keep disabled unless you intentionally need Twenty's paused FDW/wrappers path.
IS_FDW_ENABLED=false

# Used by the optional twenty-server auth:check:supabase-oidc target.
SUPABASE_AUTH_ISSUER_URL=https://supabase.example.com/auth/v1
